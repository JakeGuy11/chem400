    "# Combine the two tables so any entry can be paired with any other.\n",
    "all_e = {**echem.REFERENCE_ELECTRODES, **echem.REDOX_COUPLES}\n",
    "\n",
    "@interact\n",
    "def calc_e(cathode=list(all_e), anode=list(all_e)):\n",
    "    e_cell = echem.combine_half_cells(all_e[cathode], all_e[anode])\n",
    "    print(f'Cathode:\\t{cathode}\\t\\t {all_e[cathode]} V vs. NHE')\n",
    "    print(f'Anode:  \\t{anode}\\t\\t {all_e[anode]} V vs. NHE')\n",
    "    print(f'Cell:   \\t\\t\\t {e_cell:.3f} V')"
   ]
