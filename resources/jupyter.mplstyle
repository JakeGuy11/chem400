## Prof. Smith created this graph format to be comfortable for viewing on a computer screen
## Feel free to modify to your hearts content - it only affects your notebooks
## For guidance, see: https://matplotlib.org/stable/tutorials/introductory/customizing.html


figure.titlesize:   large     # size of the figure title (``Figure.suptitle()``)
figure.titleweight: normal    # weight of the figure title
figure.figsize:     3.5, 2.625     # figure size in inches
figure.dpi:         200       # figure dots per inch
figure.facecolor:   white     # figure face color
figure.autolayout: True  

lines.linewidth : 0.8
lines.markersize : 1.6

image.cmap: viridis

axes.grid: True
axes.titlesize : 8
axes.labelsize : 8
axes.linewidth:     0.8     # edge line width
xtick.labelsize : 6
xtick.major.size:    3     # major tick size in points
xtick.minor.size:    1.5       # minor tick size in points
xtick.major.width:   0.8     # major tick width in points
xtick.minor.width:   0.6     # minor tick width in points
xtick.direction:     out     # direction: {in, out, inout}
xtick.minor.visible: True   # visibility of minor ticks on x-axis
ytick.labelsize : 6
ytick.major.size:    3     # major tick size in points
ytick.minor.size:    1.5       # minor tick size in points
ytick.major.width:   0.8     # major tick width in points
ytick.minor.width:   0.6     # minor tick width in points
ytick.direction:     out     # direction: {in, out, inout}
ytick.minor.visible: True   # visibility of minor ticks on x-axis
axes.prop_cycle: cycler('color', [(0.318, 0.318, 0.318, 1.000),(0.945, 0.251, 0.251, 1.000),(0.102, 0.435, 0.875, 1.000),(0.216, 0.678, 0.420, 1.000),(0.694, 0.467, 0.086, 1.000),(0.800, 0.600, 0.000, 1.000),(0.000, 0.796, 0.800, 1.000),(0.490, 0.306, 0.306, 1.000),(0.557, 0.557, 0.000, 1.000),(0.984, 0.396, 0.004, 1.000),(0.400, 0.600, 0.800, 1.000),(0.435, 0.722, 0.008, 1.000)])
                  # See also https://matplotlib.org/tutorials/intermediate/color_cycle.html
                  # for more details on prop_cycle usage.


grid.color:     b0b0b0  # grid color
grid.linestyle: :       # solid
grid.linewidth: 0.5     # in points
grid.alpha:     0.3     # transparency, between 0.0 and 1.0